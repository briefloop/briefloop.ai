{
  "schema_version": "briefloop.agent-bootstrap.v1",
  "product": {
    "name": "BriefLoop",
    "version": "0.24.0",
    "homepage": "https://briefloop.ai/",
    "description": "A local agent workbench for sourced briefings, independent evaluation and reusable learning.",
    "python_requires": ">=3.11",
    "interface_language": "zh-CN",
    "report_languages": [
      "zh-CN",
      "en"
    ]
  },
  "canonical": {
    "source_repository": "https://github.com/Stahl-G/briefloop",
    "python_package": "https://pypi.org/project/briefloop/",
    "readme": "https://github.com/Stahl-G/briefloop/blob/main/README.md",
    "usage_guide": "https://github.com/Stahl-G/briefloop/blob/main/docs/使用指南.md",
    "runtime_and_models": "https://github.com/Stahl-G/briefloop/blob/main/docs/多Runtime与模型.md",
    "skill": "https://briefloop.ai/agents/briefloop/SKILL.md",
    "llms_txt": "https://briefloop.ai/llms.txt",
    "external_guide": "https://briefloop.ai/docs/external-agent.html"
  },
  "distribution": {
    "cli": {
      "package": "briefloop",
      "recommended_installer": "PyPI",
      "install_command": "python -m pip install --upgrade briefloop",
      "note": "Install the CLI on the same machine as the selected workspace service."
    },
    "package_index": {
      "package": "briefloop",
      "status": "published",
      "version": "0.24.0",
      "note": "Published package; version follows the release catalog."
    },
    "bridge_runtime": {
      "requires": "Node.js 20+",
      "note": "Codex and Opencode run natively; Claude Code, Kimi, Hermes, DeepSeek Reasonix and MiMo Code run through the bundled bridge."
    }
  },
  "runtimes": [
    {
      "id": "codex",
      "name": "Codex CLI",
      "channel": "native app-server",
      "capabilities": {
        "permission_modes": [
          "workspace-write",
          "read-only"
        ],
        "steer": true
      }
    },
    {
      "id": "opencode",
      "name": "Opencode CLI",
      "channel": "native local service",
      "capabilities": {
        "permission_modes": [
          "workspace-write",
          "read-only"
        ],
        "steer": false
      }
    },
    {
      "id": "claude",
      "name": "Claude Code",
      "channel": "bridge (stream-json)",
      "capabilities": {
        "permission_modes": [
          "runtime-native"
        ],
        "steer": false
      }
    },
    {
      "id": "kimi",
      "name": "Kimi CLI",
      "channel": "bridge (ACP)",
      "capabilities": {
        "permission_modes": [
          "runtime-native"
        ],
        "steer": false
      }
    },
    {
      "id": "hermes",
      "name": "Hermes",
      "channel": "bridge (ACP)",
      "capabilities": {
        "permission_modes": [
          "runtime-native"
        ],
        "steer": false
      }
    },
    {
      "id": "reasonix",
      "name": "DeepSeek Reasonix",
      "channel": "bridge (ACP)",
      "capabilities": {
        "permission_modes": [
          "runtime-native"
        ],
        "steer": false
      }
    },
    {
      "id": "mimo",
      "name": "MiMo Code",
      "channel": "bridge (JSON events)",
      "capabilities": {
        "permission_modes": [
          "runtime-native"
        ],
        "steer": false
      }
    }
  ],
  "roles": [
    {
      "id": "briefloop",
      "name": "BriefLoop",
      "responsibility": "conversation, research planning, drafting and revision; uses the main-chain model"
    },
    {
      "id": "evaluator",
      "name": "Evaluator",
      "responsibility": "scores drafts and compares candidates in an independent session"
    },
    {
      "id": "maintainer",
      "name": "Wiki Maintainer",
      "responsibility": "turns feedback and execution notes into the workspace Wiki"
    },
    {
      "id": "proposer",
      "name": "Skill Proposer",
      "responsibility": "proposes or improves skills from the Wiki; candidates need verification before use"
    }
  ],
  "authorization": {
    "required": "User authorization for the task, chosen materials and budget; existing in-scope authorization persists.",
    "forbidden": [
      "print_or_exfiltrate_secrets",
      "claim_verification_without_evidence",
      "present_a_queued_job_as_completed"
    ]
  },
  "references": {
    "skill": "https://briefloop.ai/agents/briefloop/SKILL.md",
    "installation": "https://briefloop.ai/agents/briefloop/references/installation.md",
    "onboarding": "https://briefloop.ai/agents/briefloop/references/onboarding.md",
    "operation": "https://briefloop.ai/agents/briefloop/references/operation.md"
  },
  "external": {
    "transport": "local CLI",
    "requires": "existing workspace and running local service",
    "discover": "briefloop external --workspace \"/absolute/workspace\" discover",
    "skill": "briefloop external --workspace \"/absolute/workspace\" skill",
    "request": "briefloop external --workspace \"/absolute/workspace\" request --file request.json",
    "actions": [
      "inspect",
      "source",
      "submit",
      "query",
      "read",
      "revise",
      "export"
    ],
    "generation_model": "workspace configuration",
    "writes": "stable request_id; revise requires base_version"
  }
}
